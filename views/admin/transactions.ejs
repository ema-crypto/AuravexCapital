<% if (success && success.length) { %><div class="a-alert a-alert-success"><%= success[0] %></div><% } %>

<div class="filter-bar">
  <% ['all','deposit','withdrawal','earning','referral','debit'].forEach(f => { %>
  <a href="/admin/transactions?filter=<%= f %>" class="btn <%= filter === f ? 'btn-gold' : 'btn-outline' %> btn-sm">
    <%= f.charAt(0).toUpperCase() + f.slice(1) %>
  </a>
  <% }) %>
</div>

<div class="a-card">
  <div class="a-card-header">
    <div class="a-card-title">Transactions (<%= transactions.length %>)</div>
  </div>
  <div class="a-table-wrap">
    <table class="a-table">
      <thead>
        <tr><th>User</th><th>Type</th><th>Amount</th><th>Currency</th><th>Wallet / Address</th><th>Status</th><th>Ref</th><th>Date</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% transactions.forEach(t => { %>
        <tr>
          <td style="font-size:.8rem;">
            <a href="/admin/users/<%= t.user_id %>"><%= t.full_name %></a>
            <div style="font-size:.72rem;color:var(--text-muted);"><%= t.email %></div>
          </td>
          <td><span class="badge <%= t.type === 'deposit' ? 'badge-green' : t.type === 'withdrawal' ? 'badge-gold' : t.type === 'earning' ? 'badge-blue' : 'badge-gray' %>"><%= t.type %></span></td>
          <td style="font-weight:600;">$<%= Number(t.amount).toFixed(2) %></td>
          <td style="font-size:.8rem;color:var(--text-muted);"><%= t.currency || '—' %></td>
          <td style="font-size:.73rem;max-width:160px;">
            <% if (t.wallet_address) { %>
            <div style="display:flex;align-items:center;gap:6px;">
              <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:120px;color:var(--text-muted);" title="<%= t.wallet_address %>"><%= t.wallet_address %></span>
              <button onclick="copyAddr(this,'<%= t.wallet_address %>')" title="Copy address"
                style="background:none;border:1px solid var(--border);border-radius:4px;padding:2px 6px;font-size:.65rem;color:var(--text-muted);cursor:pointer;flex-shrink:0;">
                Copy
              </button>
            </div>
            <% } else { %>
            <span style="color:var(--text-muted);">—</span>
            <% } %>
          </td>
          <td><span class="badge <%= t.status === 'completed' ? 'badge-green' : t.status === 'pending' ? 'badge-gold' : 'badge-red' %>"><%= t.status %></span></td>
          <td style="font-size:.73rem;color:var(--text-muted);"><%= t.txn_ref || '—' %></td>
          <td style="font-size:.78rem;color:var(--text-muted);"><%= helpers.dateStr(t.created_at) %></td>
          <td>
            <% if (t.type === 'deposit' && t.status === 'pending') { %>
            <div style="display:flex;flex-direction:column;gap:5px;">
              <form method="POST" action="/admin/transactions/<%= t.id %>/confirm-deposit">
                <button class="btn btn-sm btn-success">Confirm</button>
              </form>
              <button onclick="openEditDeposit('<%= t.id %>','<%= Number(t.amount).toFixed(2) %>')" class="btn btn-sm btn-outline">Edit</button>
            </div>
            <% } else if (t.type === 'withdrawal' && t.status === 'pending') { %>
            <div style="display:flex;flex-direction:column;gap:5px;">
              <div style="display:flex;gap:5px;">
                <form method="POST" action="/admin/transactions/<%= t.id %>/approve">
                  <button class="btn btn-sm btn-success">Approve</button>
                </form>
                <form method="POST" action="/admin/transactions/<%= t.id %>/reject">
                  <button class="btn btn-sm btn-danger">Reject</button>
                </form>
              </div>
              <button onclick="openEditWithdrawal('<%= t.id %>','<%= Number(t.amount).toFixed(2) %>','<%= (t.wallet_address || '').replace(/'/g, '') %>')" class="btn btn-sm btn-outline">Edit</button>
            </div>
            <% } else { %>
            <span style="color:var(--text-muted);font-size:.75rem;">—</span>
            <% } %>
          </td>
        </tr>
        <% }) %>
        <% if (!transactions.length) { %>
        <tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:32px;">No transactions found</td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Edit Deposit Modal -->
<dialog id="modal-edit-deposit" style="background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:28px;min-width:320px;color:var(--text);">
  <form method="POST" id="form-edit-deposit">
    <h3 style="margin:0 0 18px;font-size:1rem;">Edit Deposit Amount</h3>
    <div class="a-form-group">
      <label>Amount (USD)</label>
      <input type="number" id="edit-deposit-amount" name="amount" min="0.01" step="0.01" required
             style="width:100%;padding:9px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.9rem;">
    </div>
    <div style="display:flex;gap:10px;margin-top:16px;">
      <button type="submit" class="btn btn-gold">Save</button>
      <button type="button" onclick="document.getElementById('modal-edit-deposit').close()" class="btn btn-outline">Cancel</button>
    </div>
  </form>
</dialog>

<!-- Edit Withdrawal Modal -->
<dialog id="modal-edit-withdrawal" style="background:var(--bg2);border:1px solid var(--border);border-radius:12px;padding:28px;min-width:360px;color:var(--text);">
  <form method="POST" id="form-edit-withdrawal">
    <h3 style="margin:0 0 18px;font-size:1rem;">Edit Withdrawal</h3>
    <div class="a-form-group">
      <label>Amount (USD)</label>
      <input type="number" id="edit-wd-amount" name="amount" min="0.01" step="0.01" required
             style="width:100%;padding:9px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.9rem;">
    </div>
    <div class="a-form-group" style="margin-top:12px;">
      <label>Wallet Address</label>
      <input type="text" id="edit-wd-addr" name="wallet_address"
             style="width:100%;padding:9px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.85rem;">
    </div>
    <div style="display:flex;gap:10px;margin-top:16px;">
      <button type="submit" class="btn btn-gold">Save</button>
      <button type="button" onclick="document.getElementById('modal-edit-withdrawal').close()" class="btn btn-outline">Cancel</button>
    </div>
  </form>
</dialog>

<script>
function copyAddr(btn, addr) {
  navigator.clipboard.writeText(addr).then(() => {
    const orig = btn.textContent;
    btn.textContent = 'Copied!';
    btn.style.color = 'var(--success)';
    btn.style.borderColor = 'var(--success)';
    setTimeout(() => { btn.textContent = orig; btn.style.color = ''; btn.style.borderColor = ''; }, 2000);
  }).catch(() => {
    const ta = document.createElement('textarea');
    ta.value = addr; document.body.appendChild(ta); ta.select();
    document.execCommand('copy'); document.body.removeChild(ta);
    btn.textContent = 'Copied!';
    setTimeout(() => btn.textContent = 'Copy', 2000);
  });
}

function openEditDeposit(id, amount) {
  const form = document.getElementById('form-edit-deposit');
  form.action = '/admin/transactions/' + id + '/edit-deposit';
  document.getElementById('edit-deposit-amount').value = amount;
  document.getElementById('modal-edit-deposit').showModal();
}

function openEditWithdrawal(id, amount, addr) {
  const form = document.getElementById('form-edit-withdrawal');
  form.action = '/admin/transactions/' + id + '/edit-withdrawal';
  document.getElementById('edit-wd-amount').value = amount;
  document.getElementById('edit-wd-addr').value = addr;
  document.getElementById('modal-edit-withdrawal').showModal();
}
</script>
