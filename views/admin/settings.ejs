<% if (success && success.length) { %><div class="a-alert a-alert-success"><%= success[0] %></div><% } %>
<% if (locals.errors && errors.length) { %><div class="a-alert a-alert-error"><%= errors[0] %></div><% } %>

<div style="max-width:600px;">

  <!-- Promo Toggle -->
  <div class="a-card" style="margin-bottom:20px;border:2px solid <%= promoActive ? '#ef4444' : 'var(--border)' %>;">
    <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
      <div style="width:10px;height:10px;border-radius:50%;flex-shrink:0;background:<%= promoActive ? '#ef4444' : '#6b7280' %>;<%= promoActive ? 'box-shadow:0 0 8px #ef4444;animation:promo-pulse 1.4s infinite;' : '' %>"></div>
      <div class="a-card-title" style="margin:0;">🔥 Flash Promo Plan</div>
      <span style="margin-left:auto;font-size:.75rem;font-weight:700;padding:3px 10px;border-radius:20px;background:<%= promoActive ? 'rgba(239,68,68,.15)' : 'var(--bg3)' %>;color:<%= promoActive ? '#ef4444' : 'var(--text-muted)' %>;">
        <%= promoActive ? 'LIVE' : 'OFF' %>
      </span>
    </div>

    <% if (promoActive) { %>
      <!-- Active state: countdown + stop button with warning -->
      <div style="background:rgba(239,68,68,.07);border-radius:8px;padding:14px 16px;margin-bottom:16px;">
        <div style="font-size:.82rem;color:var(--text-muted);margin-bottom:6px;">Time remaining:</div>
        <div id="admin-countdown" data-end="<%= promoEndTime %>" data-ms="<%= promoRemainingMs %>"
             style="font-size:1.6rem;font-weight:800;font-family:monospace;color:#ef4444;letter-spacing:.05em;">
          --:--:--
        </div>
        <div id="admin-cd-label" style="font-size:.75rem;color:var(--text-muted);margin-top:4px;"></div>
      </div>
      <form method="POST" action="/admin/settings/toggle-promo" id="stop-promo-form" style="margin:0;">
        <button type="button" onclick="confirmStopPromo()" style="
          width:100%;padding:10px 0;border:none;border-radius:8px;font-weight:700;
          font-size:.9rem;cursor:pointer;background:#ef4444;color:#fff;
          box-shadow:0 2px 10px rgba(239,68,68,.35);">
          ⏹ Stop Promo
        </button>
      </form>

    <% } else { %>
      <!-- Inactive state: hours input + start button -->
      <p style="font-size:.85rem;color:var(--text-muted);margin-bottom:16px;">
        The Flash Promo plan is currently <strong>hidden</strong> from all users. Set a duration and start it when ready.
      </p>
      <form method="POST" action="/admin/settings/toggle-promo" style="margin:0;">
        <div style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
          <div style="flex:1;min-width:140px;">
            <label style="display:block;font-size:.78rem;color:var(--text-muted);margin-bottom:6px;">Duration (hours)</label>
            <input type="number" name="hours" min="0.5" max="720" step="0.5"
                   value="<%= settings.promo_hours || '24' %>"
                   style="width:100%;padding:9px 12px;background:var(--bg3);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:.9rem;"
                   placeholder="e.g. 24" required>
          </div>
          <button type="submit" style="
            padding:10px 28px;border:none;border-radius:8px;font-weight:700;
            font-size:.9rem;cursor:pointer;background:#10b981;color:#fff;
            box-shadow:0 2px 10px rgba(16,185,129,.35);white-space:nowrap;">
            ▶ Start Promo
          </button>
        </div>
      </form>
    <% } %>
  </div>

  <style>
    @keyframes promo-pulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(.85)} }
  </style>
  <script>
    // Admin countdown
    (function() {
      var el = document.getElementById('admin-countdown');
      if (!el) return;
      var end = new Date(el.dataset.end).getTime();
      var label = document.getElementById('admin-cd-label');
      function tick() {
        var rem = end - Date.now();
        if (rem <= 0) {
          el.textContent = 'Ended';
          if (label) label.textContent = 'Promo has elapsed — refresh to update status.';
          return;
        }
        var h = Math.floor(rem / 3600000);
        var m = Math.floor((rem % 3600000) / 60000);
        var s = Math.floor((rem % 60000) / 1000);
        el.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
        if (label) {
          label.textContent = h + ' hr' + (h !== 1 ? 's' : '') + ' ' + m + ' min remaining';
        }
        setTimeout(tick, 1000);
      }
      function pad(n) { return String(n).padStart(2,'0'); }
      tick();
    })();

    // Confirm early stop
    function confirmStopPromo() {
      var el = document.getElementById('admin-countdown');
      var rem = el ? (new Date(el.dataset.end).getTime() - Date.now()) : 0;
      if (rem > 60000) {
        var h = Math.floor(rem / 3600000);
        var m = Math.floor((rem % 3600000) / 60000);
        var msg = '⚠️ The promo still has ' + h + 'h ' + m + 'm remaining.\n\nEnd the promo early anyway?';
        if (!confirm(msg)) return;
      }
      document.getElementById('stop-promo-form').submit();
    }
  </script>
  <div class="a-card">
    <div class="a-card-title" style="margin-bottom:20px;">Site Configuration</div>
    <form method="POST" action="/admin/settings">
      <div class="a-form-group">
        <label>Site Name</label>
        <input type="text" name="site_name" value="<%= settings.site_name || 'AuravexCapital' %>">
      </div>
      <div class="a-form-group">
        <label>Support Email</label>
        <input type="email" name="support_email" value="<%= settings.support_email || '' %>">
      </div>
      <div class="a-form-group">
        <label>WhatsApp Number <span style="color:var(--text-muted);font-size:.75rem;">(with country code, e.g. +447911123456)</span></label>
        <input type="text" name="whatsapp_number" value="<%= settings.whatsapp_number || '' %>" placeholder="+447911123456">
      </div>
      <div class="a-form-row">
        <div class="a-form-group">
          <label>Minimum Withdrawal ($)</label>
          <input type="number" name="min_withdrawal" value="<%= settings.min_withdrawal || '10' %>" min="0" step="0.01">
        </div>
        <div class="a-form-group">
          <label>Withdrawal Fee (%)</label>
          <input type="number" name="withdrawal_fee_pct" value="<%= settings.withdrawal_fee_pct || '0' %>" min="0" max="100" step="0.1">
        </div>
      </div>
      <div class="a-form-row">
        <div class="a-form-group">
          <label>Auto-Approve Withdrawal ($) <span style="color:var(--text-muted);font-size:.75rem;">(0 = manual approval for all)</span></label>
          <input type="number" name="auto_withdrawal_limit" value="<%= settings.auto_withdrawal_limit || '0' %>" min="0" step="0.01">
        </div>
        <div class="a-form-group">
          <label>Tawk.to Widget ID <span style="color:var(--text-muted);font-size:.75rem;">(blank = disable live chat)</span></label>
          <input type="text" name="tawkto_id" value="<%= settings.tawkto_id || '' %>" placeholder="e.g. 64a1b2/1h4abcd">
        </div>
      </div>
      <button type="submit" class="btn btn-gold">Save Settings</button>
    </form>
  </div>

  <div class="a-card" style="margin-top:20px;">
    <div class="a-card-title" style="margin-bottom:16px;">Admin Credentials</div>
    <p style="font-size:.85rem;color:var(--text-muted);margin-bottom:14px;">
      To change the admin password, update the password directly in the database or add a password-change form here.
    </p>
    <div style="background:var(--bg3);padding:12px 16px;border-radius:8px;font-size:.82rem;color:var(--text-muted);">
      Login URL: <code style="color:var(--gold);">/admin/login</code>
    </div>
  </div>
</div>
