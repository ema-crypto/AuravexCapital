<div class="page-header">
  <div class="container">
    <div class="breadcrumb"><a href="/">Home</a><span class="breadcrumb-sep">/</span><span>Investment Plans</span></div>
    <h1>Investment Plans</h1>
    <p>Choose the plan that fits your investment goals</p>
  </div>
</div>

<section style="background:var(--surface-2);padding:72px 0;">
  <div class="container">
    <div class="section-title">
      <p>Plans designed to satisfy the needs of both small and large investors. All payouts are processed instantly.</p>
    </div>
    <div class="plans-grid">
      <% plans.forEach((p, i) => { %>
      <div class="plan-card <%= p.is_promo ? 'featured' : (i === 2 ? 'featured' : '') %>"
           style="<%= p.is_promo ? 'border-color:#ef4444;' : '' %>">
        <% if (p.is_promo) { %>
        <div class="featured-tag" style="background:#ef4444;">🔥 Limited Time</div>
        <% if (locals.promoEndTime) { %>
        <div class="promo-countdown" data-end="<%= promoEndTime %>"
             style="text-align:center;padding:5px 12px;background:rgba(239,68,68,.12);border-radius:6px;margin:6px 0 4px;font-size:.78rem;color:#ef4444;font-weight:700;font-family:monospace;letter-spacing:.03em;">
          ⏱ <span class="cd-val">--:--:--</span> remaining
        </div>
        <% } %>
        <% } else if (i === 2) { %><div class="featured-tag">Popular</div><% } %>
        <div class="plan-card-head">
          <div class="plan-label"><%= p.label %></div>
          <div class="plan-rate"><%= p.daily_percent %><span class="plan-rate-unit">%</span></div>
          <div class="plan-term">Daily · <%= p.term_days %>-day term</div>
        </div>
        <div class="plan-card-body">
          <div class="plan-row"><span class="pr-key">Min Deposit</span><span class="pr-val">$<%= p.min_amount.toLocaleString() %></span></div>
          <div class="plan-row"><span class="pr-key">Max Deposit</span><span class="pr-val"><%= p.max_amount ? '$' + p.max_amount.toLocaleString() : 'Unlimited' %></span></div>
          <div class="plan-row"><span class="pr-key">Total Return</span><span class="pr-val" style="color:var(--gold-500);"><%=  (p.daily_percent * p.term_days).toFixed(0) %>%</span></div>
          <div class="plan-row"><span class="pr-key">Principal</span><span class="pr-val" style="color:var(--emerald-500);"><%= p.deposit_returned ? '✓ Returned' : 'Included in payout' %></span></div>
          <div class="plan-row"><span class="pr-key">Term</span><span class="pr-val"><%= p.term_days %> Days</span></div>
          <div class="plan-row"><span class="pr-key">Payouts</span><span class="pr-val">⚡ Instant</span></div>
        </div>
        <div class="plan-card-foot">
          <a href="/register" class="btn btn-gold btn-block">Start Investing</a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<script>
(function() {
  document.querySelectorAll('.promo-countdown').forEach(function(el) {
    var end = new Date(el.dataset.end).getTime();
    var display = el.querySelector('.cd-val');
    var card = el.closest('.plan-card');
    function tick() {
      var rem = end - Date.now();
      if (rem <= 0) { if (card) card.style.display = 'none'; return; }
      var h = Math.floor(rem / 3600000);
      var m = Math.floor((rem % 3600000) / 60000);
      var s = Math.floor((rem % 60000) / 1000);
      display.textContent = pad(h)+':'+pad(m)+':'+pad(s);
      setTimeout(tick, 1000);
    }
    function pad(n) { return String(n).padStart(2,'0'); }
    tick();
  });
})();
</script>

