  <div class="container" style="max-width:760px;">
    <div class="section-title">
      <h2>How It Works</h2>
    </div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:28px;text-align:center;">
      <div>
        <div style="width:60px;height:60px;border-radius:50%;background:var(--gold-100);color:var(--gold-500);display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin:0 auto 14px;">1</div>
        <h4 style="margin-bottom:8px;">Create Account</h4>
        <p style="font-size:.875rem;">Register for free and verify your email in under a minute.</p>
      </div>
      <div>
        <div style="width:60px;height:60px;border-radius:50%;background:var(--gold-100);color:var(--gold-500);display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin:0 auto 14px;">2</div>
        <h4 style="margin-bottom:8px;">Make a Deposit</h4>
        <p style="font-size:.875rem;">Fund your account using any supported cryptocurrency.</p>
      </div>
      <div>
        <div style="width:60px;height:60px;border-radius:50%;background:var(--gold-100);color:var(--gold-500);display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin:0 auto 14px;">3</div>
        <h4 style="margin-bottom:8px;">Earn Daily</h4>
        <p style="font-size:.875rem;">Select a plan and watch your returns grow every day.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:36px;">
      <a href="/register" class="btn btn-gold btn-lg">Get Started Now</a>
    </div>
  </div>
</section>
