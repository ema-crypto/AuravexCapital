<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — AuravexCapital</title>
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div id="sidebar-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:45;"></div>
<style>
  #sidebar-overlay.active { display:block !important; }
</style>

<div class="dash-layout">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon" style="width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,#c9a227,#f0cc6a);display:flex;align-items:center;justify-content:center;font-weight:800;color:#0a0e1a;font-size:1rem;flex-shrink:0;">AC</div>
      <div>
        <div class="logo-text" style="font-size:.9rem;">Auravex<span style="color:#e0b840;">Capital</span></div>
        <div style="font-size:.65rem;color:rgba(255,255,255,.3);margin-top:1px;">Investment Platform</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section-label">Main</div>
      <a href="/dashboard" class="nav-item <%= title === 'Dashboard' ? 'active' : '' %>">
        <span class="nav-icon">📊</span> Dashboard
      </a>
      <a href="/dashboard/investments" class="nav-item <%= title === 'My Investments' ? 'active' : '' %>">
        <span class="nav-icon">💼</span> My Investments
      </a>

      <div class="nav-section-label">Finances</div>
      <a href="/dashboard/deposit" class="nav-item <%= title === 'Make a Deposit' ? 'active' : '' %>">
        <span class="nav-icon">⬇️</span> Deposit
      </a>
      <a href="/dashboard/withdraw" class="nav-item <%= title === 'Withdraw Funds' ? 'active' : '' %>">
        <span class="nav-icon">⬆️</span> Withdraw
      </a>
      <a href="/dashboard/plans" class="nav-item <%= title === 'Investment Plans' ? 'active' : '' %>">
        <span class="nav-icon">📈</span> Our Plans
      </a>
      <a href="/dashboard/history" class="nav-item <%= title === 'Transaction History' ? 'active' : '' %>">
        <span class="nav-icon">🕐</span> History
      </a>

      <div class="nav-section-label">Account</div>
      <a href="/dashboard/profile" class="nav-item <%= title === 'Profile' ? 'active' : '' %>">
        <span class="nav-icon">👤</span> Profile
      </a>
      <a href="/dashboard/kyc" class="nav-item <%= title === 'KYC Verification' ? 'active' : '' %>">
        <span class="nav-icon">🪪</span> KYC Verification
        <% if (authUser.kyc_status === 'none' || !authUser.kyc_status) { %><span style="background:#ef4444;color:#fff;font-size:.6rem;padding:1px 6px;border-radius:10px;margin-left:auto;">!</span><% } %>
        <% if (authUser.kyc_status === 'approved') { %><span style="color:var(--emerald-500);margin-left:auto;font-size:.75rem;">✓</span><% } %>
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="user-avatar"><%= authUser.full_name.charAt(0).toUpperCase() %></div>
        <div class="user-meta">
          <div class="um-name"><%= authUser.full_name %></div>
          <div class="um-role">Investor</div>
        </div>
      </div>
      <a href="/logout" class="sidebar-logout">
        <span>🚪</span> Sign Out
      </a>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="dash-main">
    <div class="dash-topbar">
      <div class="dash-topbar-left">
        <div class="hamburger" id="hamburger">
          <span></span><span></span><span></span>
        </div>
        <div class="topbar-greeting">
          <span style="color:var(--text-muted);font-size:.8rem;">Welcome back</span>
          <strong><%= authUser.full_name %></strong>
        </div>
      </div>
      <div class="topbar-actions">
        <a href="/dashboard/deposit" class="btn btn-gold btn-sm">+ Deposit</a>
        <div class="topbar-avatar"><%= authUser.full_name.charAt(0).toUpperCase() %></div>
      </div>
    </div>

    <div class="dash-content">
      <%- body %>
    </div>

    <div style="padding:20px 32px;border-top:1px solid var(--border);font-size:.75rem;color:var(--text-muted);display:flex;justify-content:space-between;">
      <span>© 2025 AuravexCapital</span>
      <span>Secure Investment Platform</span>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
<script>
  document.getElementById('hamburger').addEventListener('click', () => {
    document.getElementById('sidebar').classList.toggle('open');
    document.getElementById('sidebar-overlay').classList.toggle('active');
  });
  document.getElementById('sidebar-overlay').addEventListener('click', () => {
    document.getElementById('sidebar').classList.remove('open');
    document.getElementById('sidebar-overlay').classList.remove('active');
  });
</script>

  <!-- WhatsApp floating button -->
  <% const whatsappNum = locals.whatsappNumber || ''; %>
  <% if (whatsappNum) { %>
  <a href="https://wa.me/<%= whatsappNum.replace(/\D/g,'') %>" target="_blank" rel="noopener"
     style="position:fixed;bottom:28px;right:28px;z-index:9999;width:52px;height:52px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.5);text-decoration:none;"
     title="Chat on WhatsApp">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>
  <% } %>
</body>
</html>
