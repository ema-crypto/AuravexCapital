<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — AuravexCapital</title>
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div id="sidebar-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:45;"></div>
<style>
  #sidebar-overlay.active { display:block !important; }
</style>

<div class="dash-layout">
  <!-- SIDEBAR -->
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-logo">
      <div class="logo-icon" style="width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,#c9a227,#f0cc6a);display:flex;align-items:center;justify-content:center;font-weight:800;color:#0a0e1a;font-size:1rem;flex-shrink:0;">AC</div>
      <div>
        <div class="logo-text" style="font-size:.9rem;">Auravex<span style="color:#e0b840;">Capital</span></div>
        <div style="font-size:.65rem;color:rgba(255,255,255,.3);margin-top:1px;">Investment Platform</div>
      </div>
    </div>

    <nav class="sidebar-nav">
      <div class="nav-section-label">Main</div>
      <a href="/dashboard" class="nav-item <%= title === 'Dashboard' ? 'active' : '' %>">
        <span class="nav-icon">📊</span> Dashboard
      </a>
      <a href="/dashboard/investments" class="nav-item <%= title === 'My Investments' ? 'active' : '' %>">
        <span class="nav-icon">💼</span> My Investments
      </a>

      <div class="nav-section-label">Finances</div>
      <a href="/dashboard/deposit" class="nav-item <%= title === 'Make a Deposit' ? 'active' : '' %>">
        <span class="nav-icon">⬇️</span> Deposit
      </a>
      <a href="/dashboard/withdraw" class="nav-item <%= title === 'Withdraw Funds' ? 'active' : '' %>">
        <span class="nav-icon">⬆️</span> Withdraw
      </a>
      <a href="/dashboard/plans" class="nav-item <%= title === 'Investment Plans' ? 'active' : '' %>">
        <span class="nav-icon">📈</span> Our Plans
      </a>
      <a href="/dashboard/history" class="nav-item <%= title === 'Transaction History' ? 'active' : '' %>">
        <span class="nav-icon">🕐</span> History
      </a>

      <div class="nav-section-label">Account</div>
      <a href="/dashboard/profile" class="nav-item <%= title === 'Profile' ? 'active' : '' %>">
        <span class="nav-icon">👤</span> Profile
      </a>
      <a href="/dashboard/kyc" class="nav-item <%= title === 'KYC Verification' ? 'active' : '' %>">
        <span class="nav-icon">🪪</span> KYC Verification
        <% if (authUser.kyc_status === 'none' || !authUser.kyc_status) { %><span style="background:#ef4444;color:#fff;font-size:.6rem;padding:1px 6px;border-radius:10px;margin-left:auto;">!</span><% } %>
        <% if (authUser.kyc_status === 'approved') { %><span style="color:var(--emerald-500);margin-left:auto;font-size:.75rem;">✓</span><% } %>
      </a>
      <a href="/dashboard/referrals" class="nav-item <%= title === 'Referral Program' ? 'active' : '' %>">
        <span class="nav-icon">🤝</span> Referrals
      </a>
    </nav>

    <div class="sidebar-footer">
      <div class="sidebar-user">
        <div class="user-avatar"><%= authUser.full_name.charAt(0).toUpperCase() %></div>
        <div class="user-meta">
          <div class="um-name"><%= authUser.full_name %></div>
          <div class="um-role">Investor</div>
        </div>
      </div>
      <a href="/logout" class="sidebar-logout">
        <span>🚪</span> Sign Out
      </a>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="dash-main">
    <div class="dash-topbar">
      <div class="dash-topbar-left">
        <div class="hamburger" id="hamburger">
          <span></span><span></span><span></span>
        </div>
        <div class="topbar-greeting">
          <span style="color:var(--text-muted);font-size:.8rem;">Welcome back</span>
          <strong><%= authUser.full_name %></strong>
        </div>
      </div>
      <div class="topbar-actions">
        <a href="/dashboard/deposit" class="btn btn-gold btn-sm">+ Deposit</a>
        <div class="topbar-avatar"><%= authUser.full_name.charAt(0).toUpperCase() %></div>
      </div>
    </div>

    <% if (authUser && !authUser.email_verified) { %>
    <div style="background:linear-gradient(135deg,#d97706,#f59e0b);color:#0a0e1a;padding:10px 24px;display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:.85rem;font-weight:500;">
      <span>⚠️ Your email is not verified. Verify it to unlock investing.</span>
      <form method="POST" action="/dashboard/resend-verification" style="margin:0;">
        <button type="submit" style="background:#0a0e1a;color:#f0cc6a;border:none;padding:5px 14px;border-radius:5px;font-size:.8rem;font-weight:700;cursor:pointer;white-space:nowrap;">Resend Email</button>
      </form>
    </div>
    <% } %>

    <div class="dash-content">
      <%- body %>
    </div>

    <div style="padding:20px 32px;border-top:1px solid var(--border);font-size:.75rem;color:var(--text-muted);display:flex;justify-content:space-between;">
      <span>© 2026 AuravexCapital</span>
      <span>Secure Investment Platform</span>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>

  <!-- Tawk.to live chat -->
  <% if (locals.tawktoId && tawktoId) { %>
  <script type="text/javascript">
    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
    (function(){var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
    s1.async=true;s1.src='https://embed.tawk.to/<%= tawktoId %>/default';
    s1.charset='UTF-8';s1.setAttribute('crossorigin','*');
    s0.parentNode.insertBefore(s1,s0);})();
  </script>
  <% } %>

  <!-- In-site chat widget -->
  <div id="chat-widget" style="position:fixed;bottom:96px;right:28px;z-index:9998;display:flex;flex-direction:column;align-items:flex-end;gap:0;">
    <!-- Panel -->
    <div id="chat-panel" hidden style="width:320px;background:#0f1629;border:1px solid #1e2a4a;border-radius:16px;box-shadow:0 8px 32px rgba(0,0,0,.5);overflow:hidden;margin-bottom:10px;display:flex;flex-direction:column;">
      <div style="background:linear-gradient(135deg,#c9a227,#e0b840);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;">
        <span style="font-weight:700;color:#0a0e1a;font-size:.9rem;">💬 Support Chat</span>
        <button onclick="closeChat()" style="background:rgba(0,0,0,.15);border:none;width:24px;height:24px;border-radius:50%;cursor:pointer;color:#0a0e1a;font-size:.8rem;display:flex;align-items:center;justify-content:center;">✕</button>
      </div>
      <div id="chat-msgs" style="padding:14px;height:280px;overflow-y:auto;display:flex;flex-direction:column;gap:10px;font-size:.825rem;">
        <div id="chat-empty" style="text-align:center;color:#5a6478;padding:40px 0;">Send a message and our team will reply shortly.</div>
      </div>
      <form id="chat-form" style="padding:10px 14px;border-top:1px solid #1e2a4a;display:flex;gap:8px;">
        <input id="chat-input" type="text" placeholder="Type a message…" autocomplete="off"
          style="flex:1;padding:8px 12px;background:#161e3a;border:1px solid #253158;border-radius:8px;color:#f0f2f8;font-size:.825rem;font-family:inherit;" />
        <button type="submit" style="background:#c9a227;color:#0a0e1a;border:none;border-radius:8px;padding:8px 14px;font-weight:700;font-size:.8rem;cursor:pointer;">Send</button>
      </form>
    </div>
    <!-- Toggle button -->
    <button id="chat-btn" onclick="toggleChat()" title="Support Chat"
      style="width:52px;height:52px;border-radius:50%;background:#1e2a4a;border:2px solid #c9a227;color:#c9a227;font-size:1.3rem;cursor:pointer;box-shadow:0 4px 16px rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;position:relative;">
      💬
      <span id="chat-badge" hidden style="position:absolute;top:-4px;right:-4px;background:#f43f5e;color:#fff;font-size:.6rem;font-weight:700;padding:2px 5px;border-radius:10px;"></span>
    </button>
  </div>

  <script>
    let chatOpen = false;

    function toggleChat() { chatOpen ? closeChat() : openChat(); }

    function openChat() {
      chatOpen = true;
      document.getElementById('chat-panel').hidden = false;
      document.getElementById('chat-badge').hidden = true;
      loadMsgs();
    }

    function closeChat() {
      chatOpen = false;
      document.getElementById('chat-panel').hidden = true;
    }

    function escHtml(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\n/g,'<br>'); }

    async function loadMsgs() {
      try {
        const r = await fetch('/api/chat');
        if (!r.ok) return;
        const d = await r.json();
        const box = document.getElementById('chat-msgs');
        const empty = document.getElementById('chat-empty');
        if (d.messages && d.messages.length) {
          if (empty) empty.remove();
          const existing = new Set([...box.querySelectorAll('[data-id]')].map(el => el.dataset.id));
          d.messages.forEach(m => {
            if (existing.has(String(m.id))) return;
            const div = document.createElement('div');
            div.dataset.id = m.id;
            div.style.cssText = `display:flex;flex-direction:column;align-items:${m.sender==='admin'?'flex-end':'flex-start'}`;
            div.innerHTML = `
              <div style="max-width:80%;padding:8px 12px;border-radius:10px;background:${m.sender==='admin'?'#c9a227':'#1e2a4a'};color:${m.sender==='admin'?'#0a0e1a':'#f0f2f8'};line-height:1.5;">${escHtml(m.message)}</div>
              <div style="font-size:.65rem;color:#5a6478;margin-top:3px;">${m.sender==='admin'?'Support':'You'} · ${m.time}</div>`;
            box.appendChild(div);
          });
          box.scrollTop = box.scrollHeight;
        }
      } catch(e) {}
    }

    document.getElementById('chat-form').addEventListener('submit', async e => {
      e.preventDefault();
      const input = document.getElementById('chat-input');
      const msg = input.value.trim();
      if (!msg) return;
      input.value = '';
      try {
        await fetch('/api/chat', { method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({ message: msg }) });
        loadMsgs();
      } catch(e) {}
    });

    // Poll messages while panel is open
    setInterval(() => { if (chatOpen) loadMsgs(); }, 20000);

    // Unread-badge poll when panel is closed
    async function checkUnread() {
      if (chatOpen) return;
      try {
        const r = await fetch('/api/chat/unread');
        const d = await r.json();
        const badge = document.getElementById('chat-badge');
        if (d.count > 0) { badge.textContent = d.count; badge.hidden = false; }
        else { badge.hidden = true; }
      } catch(e) {}
    }
    setInterval(checkUnread, 30000);
    checkUnread();
  </script>

  <!-- WhatsApp floating button -->
  <% const whatsappNum = locals.whatsappNumber || ''; %>
  <% if (whatsappNum) { %>
  <a href="https://wa.me/<%= whatsappNum.replace(/\D/g,'') %>" target="_blank" rel="noopener"
     style="position:fixed;bottom:28px;right:28px;z-index:9999;width:52px;height:52px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.5);text-decoration:none;"
     title="Chat on WhatsApp">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>
  <% } %>
</body>
</html>
