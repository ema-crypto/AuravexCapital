<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — AuravexCapital</title>
  <meta name="description" content="AuravexCapital — Oil field investment platform with daily returns. Invest securely in Texas energy production.">
  <link rel="icon" href="/images/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <!-- NAV -->
  <header class="pub-header">
    <nav class="pub-nav">
      <a href="/" class="pub-logo">
        <div class="logo-icon">AC</div>
        <span class="logo-text">Auravex<span>Capital</span></span>
      </a>
      <div class="pub-nav-links" id="pub-nav-links">
        <a href="/" class="<%= title === 'Home' ? 'active' : '' %>">Home</a>
        <a href="/about" class="<%= title === 'About Us' ? 'active' : '' %>">About Us</a>
        <a href="/plans" class="<%= title === 'Investment Plans' ? 'active' : '' %>">Plans</a>
        <a href="/faq" class="<%= title === 'FAQ' ? 'active' : '' %>">FAQ</a>
        <a href="/contact" class="<%= title === 'Contact Us' ? 'active' : '' %>">Contact</a>
      </div>
      <div class="pub-nav-actions">
        <% if (locals.isLoggedIn) { %>
          <a href="/dashboard" class="btn btn-outline btn-sm">Dashboard</a>
          <a href="/logout" class="btn btn-gold btn-sm">Logout</a>
        <% } else { %>
          <a href="/login" class="btn btn-outline btn-sm">Login</a>
          <a href="/register" class="btn btn-gold btn-sm">Get Started</a>
        <% } %>
      </div>
      <!-- Mobile hamburger -->
      <button class="pub-hamburger" id="pub-hamburger" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
    </nav>
    <!-- Mobile drawer -->
    <div class="pub-mobile-menu" id="pub-mobile-menu">
      <a href="/" class="<%= title === 'Home' ? 'active' : '' %>">Home</a>
      <a href="/about" class="<%= title === 'About Us' ? 'active' : '' %>">About Us</a>
      <a href="/plans" class="<%= title === 'Investment Plans' ? 'active' : '' %>">Plans</a>
      <a href="/faq" class="<%= title === 'FAQ' ? 'active' : '' %>">FAQ</a>
      <a href="/contact" class="<%= title === 'Contact Us' ? 'active' : '' %>">Contact</a>
      <div class="pub-mobile-actions">
        <% if (locals.isLoggedIn) { %>
          <a href="/dashboard" class="btn btn-outline btn-sm">Dashboard</a>
          <a href="/logout" class="btn btn-gold btn-sm">Logout</a>
        <% } else { %>
          <a href="/login" class="btn btn-outline btn-sm">Login</a>
          <a href="/register" class="btn btn-gold btn-sm">Get Started</a>
        <% } %>
      </div>
    </div>
  </header>

  <!-- PAGE CONTENT -->
  <%- body %>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-top">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <div style="display:flex;align-items:center;gap:10px;margin-bottom:14px;">
              <div class="logo-icon" style="width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,#c9a227,#f0cc6a);display:flex;align-items:center;justify-content:center;font-weight:800;color:#0a0e1a;font-size:1rem;">AC</div>
              <span style="color:#fff;font-weight:700;">Auravex<span style="color:#e0b840;">Capital</span></span>
            </div>
            <p class="footer-tagline">A modern investment platform focused on energy sector growth and consistent daily returns for our investors.</p>
          </div>
          <div class="footer-col">
            <h4>Company</h4>
            <ul>
              <li><a href="/about">About Us</a></li>
              <li><a href="/plans">Investment Plans</a></li>
              <li><a href="/faq">FAQ</a></li>
              <li><a href="/contact">Contact</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Account</h4>
            <ul>
              <li><a href="/login">Login</a></li>
              <li><a href="/register">Create Account</a></li>
              <li><a href="/dashboard">Dashboard</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h4>Contact</h4>
            <div class="footer-contact-row">
              <span class="footer-contact-icon">📍</span>
              <span style="font-size:.85rem;color:var(--text-secondary);">Egerton Wharf, Wirral,<br>United Kingdom, CH41 1LD</span>
            </div>
            <div class="footer-contact-row">
              <span class="footer-contact-icon">✉️</span>
              <a href="mailto:support@auravexcapital.ltd" style="font-size:.85rem;color:var(--text-secondary);">support@auravexcapital.ltd</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="footer-bottom" style="padding:20px 24px;max-width:1200px;margin:0 auto;">
      <span>© 2026 AuravexCapital. All Rights Reserved.</span>
      <span style="color:var(--gold-400);">Secure · Transparent · Profitable</span>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    const ham = document.getElementById('pub-hamburger');
    const menu = document.getElementById('pub-mobile-menu');
    ham && ham.addEventListener('click', () => {
      const open = menu.classList.toggle('open');
      ham.classList.toggle('open', open);
    });
    // Close on link click
    menu && menu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
      menu.classList.remove('open');
      ham.classList.remove('open');
    }));
  </script>

  <!-- Tawk.to live chat -->
  <% if (locals.tawktoId && tawktoId) { %>
  <script type="text/javascript">
    var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
    (function(){var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
    s1.async=true;s1.src='https://embed.tawk.to/<%= tawktoId %>/default';
    s1.charset='UTF-8';s1.setAttribute('crossorigin','*');
    s0.parentNode.insertBefore(s1,s0);})();
  </script>
  <% } %>

  <!-- WhatsApp floating button -->
  <% const whatsappNum = locals.whatsappNumber || ''; %>
  <% if (whatsappNum) { %>
  <a href="https://wa.me/<%= whatsappNum.replace(/\D/g,'') %>" target="_blank" rel="noopener"
     style="position:fixed;bottom:28px;right:28px;z-index:9999;width:56px;height:56px;border-radius:50%;background:#25d366;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.5);text-decoration:none;"
     title="Chat on WhatsApp">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
  </a>
  <% } %>
</body>
</html>
