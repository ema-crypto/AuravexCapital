<div class="auth-wrapper">
  <div class="auth-side">
    <div class="auth-side-content">
      <div class="auth-side-icon">🔑</div>
      <h2>Reset Your Password</h2>
      <p>Don't worry — it happens to the best of us. We'll send you a reset link.</p>
    </div>
  </div>
  <div class="auth-main">
    <div class="auth-form-wrap" style="max-width:380px;">
      <h1 style="font-size:1.5rem;">Forgot Password</h1>
      <p class="subtitle">Enter your email to receive a password reset link</p>

      <% if (locals.success && success.length) { %>
      <div class="alert alert-success">✅ <%= success[0] %></div>
      <% } %>
      <% if (locals.errors && errors.length) { %>
      <div class="alert alert-error">⚠️ <%= errors[0] %></div>
      <% } %>

      <form action="/forgot-password" method="POST">
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <div class="input-wrap">
            <span class="input-icon">✉️</span>
            <input type="email" name="email" class="form-control" placeholder="your@email.com" required>
          </div>
        </div>
        <button type="submit" class="btn btn-gold btn-block btn-lg">Send Reset Link</button>
      </form>

      <p class="auth-footer-link"><a href="/login">← Back to Login</a></p>
    </div>
  </div>
</div>
