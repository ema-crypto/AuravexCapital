<div class="dash-page-title" style="display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px;">
  <div>
    <h1>Transaction History</h1>
    <p>All deposits, withdrawals, and investment activity</p>
  </div>
  <a href="/dashboard/deposit" class="btn btn-gold">Make Deposit</a>
</div>

<div class="data-card">
  <div class="data-card-head">
    <h3>All Transactions</h3>
    <span style="font-size:.8rem;color:var(--text-muted);"><%= transactions.length %> record<%= transactions.length !== 1 ? 's' : '' %></span>
  </div>
  <% if (transactions.length === 0) { %>
  <div class="data-empty">
    <div class="de-icon">📋</div>
    No transactions found.<br>
    <a href="/dashboard/deposit" style="color:var(--gold-500);margin-top:8px;display:inline-block;">Make your first deposit →</a>
  </div>
  <% } else { %>
  <div style="overflow-x:auto;">
    <table class="data-table">
      <thead>
        <tr>
          <th>Type</th>
          <th>Details</th>
          <th>Amount</th>
          <th>Currency</th>
          <th>Status</th>
          <th>Reference</th>
          <th>Date</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach(t => { %>
        <tr>
          <td><span class="badge badge-<%= t.type %>"><%= t.type %></span></td>
          <td style="font-size:.82rem;color:var(--text-muted);max-width:200px;"><%= t.note || '—' %></td>
          <td style="font-weight:700;color:<%= t.type === 'withdrawal' ? 'var(--rose-500)' : 'var(--emerald-500)' %>">
            <%= t.type === 'withdrawal' ? '-' : '+' %><%= helpers.currency(t.amount) %>
          </td>
          <td style="font-size:.8rem;"><%= t.currency %></td>
          <td><span class="badge badge-<%= t.status %>"><%= t.status %></span></td>
          <td style="font-family:monospace;font-size:.75rem;color:var(--text-muted);"><%= t.txn_ref || '—' %></td>
          <td style="color:var(--text-muted);font-size:.8rem;white-space:nowrap;"><%= helpers.dateStr(t.created_at) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
