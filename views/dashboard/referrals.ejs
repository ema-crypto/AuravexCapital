<div class="dash-page-title">
  <h1>Referral Program</h1>
  <p>Earn commissions by inviting friends to invest on AuravexCapital</p>
</div>

<% if (locals.success && success.length) { %><div class="alert alert-success">✅ <%= success[0] %></div><% } %>

<!-- Stats Row -->
<div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:28px;">
  <div class="form-card" style="text-align:center;padding:20px 16px;">
    <div style="font-size:2rem;font-weight:800;color:var(--gold-500);">$<%= totalCommission.toFixed(2) %></div>
    <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;">Total Earned</div>
  </div>
  <div class="form-card" style="text-align:center;padding:20px 16px;">
    <div style="font-size:2rem;font-weight:800;color:var(--gold-400);"><%= l1 %></div>
    <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;">Level 1 Referrals</div>
  </div>
  <div class="form-card" style="text-align:center;padding:20px 16px;">
    <div style="font-size:2rem;font-weight:800;color:var(--text-dark);"><%= l2 %></div>
    <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;">Level 2 Referrals</div>
  </div>
  <div class="form-card" style="text-align:center;padding:20px 16px;">
    <div style="font-size:2rem;font-weight:800;color:var(--text-dark);"><%= l3 %></div>
    <div style="font-size:.78rem;color:var(--text-muted);margin-top:4px;">Level 3 Referrals</div>
  </div>
</div>

<!-- Referral Link -->
<div class="form-card" style="margin-bottom:24px;">
  <h3 style="margin-bottom:4px;">Your Referral Link</h3>
  <p style="font-size:.85rem;color:var(--text-muted);margin-bottom:16px;">Share this link with friends. When they invest, you earn a 5% commission automatically.</p>
  <div style="display:flex;gap:10px;align-items:stretch;">
    <div style="flex:1;background:var(--surface-2);border:1px solid var(--border);border-radius:8px;padding:12px 16px;font-family:monospace;font-size:.85rem;word-break:break-all;color:var(--text-dark);" id="ref-link-text"><%= referralLink %></div>
    <button onclick="copyRefLink()" class="btn btn-gold" id="copy-ref-btn" style="white-space:nowrap;">📋 Copy Link</button>
  </div>
  <div style="margin-top:16px;display:flex;gap:12px;flex-wrap:wrap;">
    <div style="background:var(--surface-2);border-radius:8px;padding:10px 16px;font-size:.82rem;">
      <span style="color:var(--text-muted);">Your code: </span>
      <strong style="color:var(--gold-500);" id="ref-code"><%= user.referral_code %></strong>
    </div>
    <div style="background:var(--surface-2);border-radius:8px;padding:10px 16px;font-size:.82rem;">
      <span style="color:var(--text-muted);">Referral balance: </span>
      <strong style="color:var(--success);">$<%= Number(user.referral_balance).toFixed(2) %></strong>
    </div>
  </div>
</div>

<!-- Commission Structure -->
<div class="form-card" style="margin-bottom:24px;">
  <h3 style="margin-bottom:16px;">Commission Structure</h3>
  <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px;">
    <div style="background:linear-gradient(135deg,rgba(201,162,39,.15),rgba(201,162,39,.05));border:1px solid rgba(201,162,39,.3);border-radius:12px;padding:20px;text-align:center;">
      <div style="font-size:2rem;font-weight:800;color:var(--gold-400);">5%</div>
      <div style="font-weight:600;margin:6px 0 4px;">Level 1</div>
      <div style="font-size:.8rem;color:var(--text-muted);">Direct referrals</div>
    </div>
    <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:20px;text-align:center;">
      <div style="font-size:2rem;font-weight:800;color:var(--text-dark);">5%</div>
      <div style="font-weight:600;margin:6px 0 4px;">Level 2</div>
      <div style="font-size:.8rem;color:var(--text-muted);">Your referrals' referrals</div>
    </div>
    <div style="background:var(--surface-2);border:1px solid var(--border);border-radius:12px;padding:20px;text-align:center;">
      <div style="font-size:2rem;font-weight:800;color:var(--text-dark);">5%</div>
      <div style="font-weight:600;margin:6px 0 4px;">Level 3</div>
      <div style="font-size:.8rem;color:var(--text-muted);">Third-level network</div>
    </div>
  </div>
  <p style="font-size:.82rem;color:var(--text-muted);margin-top:14px;">Commissions are credited to your referral balance when your referred users make investments. You can withdraw your referral balance at any time.</p>
</div>

<!-- Referral Table -->
<% if (referrals.length) { %>
<div class="form-card">
  <h3 style="margin-bottom:16px;">Referral History (<%= referrals.length %>)</h3>
  <div style="overflow-x:auto;">
    <table style="width:100%;border-collapse:collapse;font-size:.875rem;">
      <thead>
        <tr style="border-bottom:1px solid var(--border);">
          <th style="padding:10px 12px;text-align:left;font-size:.72rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em;">Name</th>
          <th style="padding:10px 12px;text-align:left;font-size:.72rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em;">Email</th>
          <th style="padding:10px 12px;text-align:center;font-size:.72rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em;">Level</th>
          <th style="padding:10px 12px;text-align:right;font-size:.72rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em;">Commission</th>
          <th style="padding:10px 12px;text-align:right;font-size:.72rem;color:var(--text-muted);font-weight:600;text-transform:uppercase;letter-spacing:.05em;">Joined</th>
        </tr>
      </thead>
      <tbody>
        <% referrals.forEach(r => { %>
        <tr style="border-bottom:1px solid var(--border);">
          <td style="padding:12px;font-weight:500;"><%= r.full_name %></td>
          <td style="padding:12px;color:var(--text-muted);font-size:.82rem;"><%= r.email %></td>
          <td style="padding:12px;text-align:center;">
            <span style="background:var(--surface-2);color:var(--gold-400);font-size:.72rem;font-weight:700;padding:3px 10px;border-radius:20px;">L<%= r.level %></span>
          </td>
          <td style="padding:12px;text-align:right;font-weight:600;color:var(--success);">$<%= Number(r.commission).toFixed(2) %></td>
          <td style="padding:12px;text-align:right;font-size:.78rem;color:var(--text-muted);"><%= helpers.dateStr(r.created_at) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } else { %>
<div class="form-card" style="text-align:center;padding:40px 20px;">
  <div style="font-size:3rem;margin-bottom:16px;">🤝</div>
  <h3 style="margin-bottom:8px;">No referrals yet</h3>
  <p style="color:var(--text-muted);margin-bottom:20px;">Share your referral link to start earning commissions when friends invest.</p>
  <button onclick="copyRefLink()" class="btn btn-gold">Copy Referral Link</button>
</div>
<% } %>

<script>
function copyRefLink() {
  const link = document.getElementById('ref-link-text').textContent.trim();
  navigator.clipboard.writeText(link).then(() => {
    const btn = document.getElementById('copy-ref-btn');
    btn.textContent = '✅ Copied!';
    setTimeout(() => { btn.textContent = '📋 Copy Link'; }, 2000);
  });
}
</script>
