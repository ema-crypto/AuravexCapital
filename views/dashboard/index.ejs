<div class="dash-page-title">
  <h1>Welcome, <%= user.full_name.split(' ')[0] %> 👋</h1>
  <p>Here's your investment overview</p>
</div>

<!-- Flash messages -->
<% if (locals.success) { %><div class="alert alert-success">✅ <%= success %></div><% } %>

<!-- Stats row -->
<div class="stats-row">
  <div class="stat-card">
    <div class="sc-icon gold">💰</div>
    <div class="sc-val"><%= currency(user.balance) %></div>
    <div class="sc-lbl">Available Balance</div>
  </div>
  <div class="stat-card">
    <div class="sc-icon emerald">📈</div>
    <div class="sc-val"><%= currency(activeTotal) %></div>
    <div class="sc-lbl">Active Investments</div>
  </div>
  <div class="stat-card">
    <div class="sc-icon blue">🤝</div>
    <div class="sc-val"><%= currency(user.referral_balance) %></div>
    <div class="sc-lbl">Referral Earnings</div>
  </div>
</div>

<!-- Hero cards row -->
<div class="hero-cards-row">
  <div class="big-card big-card-invest">
    <div class="big-card-icon">💼</div>
    <div class="bc-label">Active Investment</div>
    <div class="bc-value"><%= currency(activeTotal) %></div>
    <div class="bc-sub"><%= activeInvestments.length %> active plan<%= activeInvestments.length !== 1 ? 's' : '' %></div>
    <div class="bc-actions">
      <a href="/dashboard/plans" class="btn-glass">Invest Now</a>
      <a href="/dashboard/investments" class="btn-glass">View All</a>
    </div>
  </div>

  <div class="big-card big-card-balance">
    <div style="margin-bottom:6px;">
      <div class="bc-label">Wallet Balance</div>
      <div class="bc-value"><%= currency(user.balance) %> <span style="font-size:1rem;color:rgba(255,255,255,.4);">USDT</span></div>
    </div>
    <div style="border-top:1px solid rgba(255,255,255,.08);padding-top:14px;margin-top:14px;">
      <div class="bc-label">Referral Balance</div>
      <div style="font-size:1.4rem;font-weight:700;color:#fff;"><%= currency(user.referral_balance) %></div>
      <div class="bc-sub">Direct referrals: <%= totalReferrals %></div>
    </div>
    <div class="bc-actions">
      <a href="/dashboard/deposit" class="btn-glass">Deposit</a>
      <a href="/dashboard/withdraw" class="btn-glass">Withdraw</a>
    </div>
  </div>
</div>

<!-- Recent transactions + referral -->
<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:20px;margin-bottom:20px;">
  <div class="data-card">
    <div class="data-card-head">
      <h3>Recent Transactions</h3>
      <a href="/dashboard/history" style="font-size:.8rem;color:var(--gold-500);">View All</a>
    </div>
    <% if (recentTxns.length === 0) { %>
    <div class="data-empty">
      <div class="de-icon">📋</div>
      No recent transactions
    </div>
    <% } else { %>
    <table class="data-table">
      <thead><tr><th>Type</th><th>Amount</th><th>Status</th><th>Date</th></tr></thead>
      <tbody>
        <% recentTxns.forEach(t => { %>
        <tr>
          <td><span class="badge badge-<%= t.type %>"><%= t.type %></span></td>
          <td style="font-weight:600;"><%= currency(t.amount) %></td>
          <td><span class="badge badge-<%= t.status %>"><%= t.status %></span></td>
          <td style="color:var(--text-muted);font-size:.8rem;"><%= timeAgo(t.created_at) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <div class="data-card">
    <div class="data-card-head">
      <h3>Active Plans</h3>
      <a href="/dashboard/plans" style="font-size:.8rem;color:var(--gold-500);">New +</a>
    </div>
    <% if (activeInvestments.length === 0) { %>
    <div class="data-empty">
      <div class="de-icon">📈</div>
      No active investments.<br>
      <a href="/dashboard/plans" style="color:var(--gold-500);">Start investing →</a>
    </div>
    <% } else { %>
    <table class="data-table">
      <thead><tr><th>Plan</th><th>Amount</th><th>Rate</th></tr></thead>
      <tbody>
        <% activeInvestments.forEach(inv => { %>
        <tr>
          <td><span class="badge badge-active"><%= inv.plan_name %></span></td>
          <td style="font-weight:600;"><%= currency(inv.amount) %></td>
          <td style="color:var(--gold-500);font-weight:700;"><%= inv.daily_percent %>%/d</td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>
</div>

<!-- Referral card -->
<div class="referral-dash-card">
  <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:16px;">
    <div>
      <h3 style="color:#fff;margin-bottom:6px;">🎁 Refer & Earn</h3>
      <p style="color:var(--text-secondary);font-size:.875rem;">Share your referral link and earn 5% on every investment your referrals make — across 3 levels.</p>
    </div>
    <div class="ref-stats-row">
      <div class="rsr-item">
        <div class="rsr-val"><%= totalReferrals %></div>
        <div class="rsr-lbl">Referrals</div>
      </div>
      <div class="rsr-item">
        <div class="rsr-val"><%= currency(user.referral_balance) %></div>
        <div class="rsr-lbl">Earned</div>
      </div>
      <div class="rsr-item">
        <div class="rsr-val">5%</div>
        <div class="rsr-lbl">Commission</div>
      </div>
    </div>
  </div>
  <div class="ref-link-row">
    <input id="ref-link-input" type="text" class="ref-link-input" value="http://localhost:3000/register?ref=<%= user.referral_code %>" readonly>
    <button id="copy-ref-link" class="btn btn-gold btn-sm">Copy Link</button>
  </div>
</div>
